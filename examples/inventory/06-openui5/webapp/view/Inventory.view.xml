<mvc:View controllerName="course.inventory.controller.Inventory"
  xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns="sap.m" displayBlock="true">
    <Page title="{i18n>appTitle}">
      <content>
        <VBox class="sapUiSmallMargin">
          <HBox wrap="Wrap" alignItems="Center">
            <Label text="{i18n>language}" labelFor="language" class="sapUiTinyMarginEnd" />
            <Select id="language" selectedKey="{ui>/language}" change=".onLanguageChange">
              <core:Item key="zh-CN" text="中文" /><core:Item key="en" text="English" />
            </Select>
            <Text text="{i18n>restartNote}" class="sapUiTinyMarginBegin" />
          </HBox>
          <Label text="{i18n>productId}" labelFor="productId" />
          <HBox wrap="Wrap" alignItems="Center">
            <Input id="productId" value="P002" width="10rem" />
            <Button text="{i18n>inspect}" press=".onInspect" class="sapUiTinyMarginBegin" />
          </HBox>
          <Text id="message" text="{ui>/message}" wrapping="true" />
          <Label text="{i18n>search}" labelFor="search" class="sapUiSmallMarginTop" />
          <SearchField id="search" value="{ui>/query}" search=".onFilter" width="100%" />
          <HBox wrap="Wrap" class="sapUiSmallMarginTop">
            <Label text="{i18n>visibleCount}" class="sapUiTinyMarginEnd" />
            <Text id="count" text="{ui>/count}" class="sapUiSmallMarginEnd" />
            <Label text="{i18n>totalStock}" class="sapUiTinyMarginEnd" />
            <Text id="totalStock" text="{ui>/stock}" class="sapUiSmallMarginEnd" />
            <Label text="{i18n>totalValue}" class="sapUiTinyMarginEnd" />
            <Text id="totalValue" text="{path: 'ui>/valueCents', formatter: '.formatter.money'}" />
          </HBox>
          <Table id="products" items="{inventory>/products}" updateFinished=".onUpdateFinished"
            noDataText="{i18n>noProducts}" class="sapUiSmallMarginTop">
            <columns>
              <Column><Text text="{i18n>product}" /></Column>
              <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>category}" /></Column>
              <Column hAlign="End"><Text text="{i18n>stock}" /></Column>
              <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>price}" /></Column>
              <Column hAlign="End"><Text text="{i18n>actions}" /></Column>
            </columns>
            <items>
              <ColumnListItem type="Navigation" press=".onDetail">
                <cells>
                  <ObjectIdentifier title="{inventory>name}" text="{inventory>id}" />
                  <Text text="{inventory>category}" />
                  <ObjectNumber number="{inventory>stock}"
                    state="{= %{inventory>stock} === 0 ? 'Error' : 'None' }" />
                  <ObjectNumber number="{path: 'inventory>priceCents', formatter: '.formatter.money'}" />
                  <Button text="{i18n>edit}" press=".onEdit" />
                </cells>
              </ColumnListItem>
            </items>
          </Table>
        </VBox>
      </content>
    </Page>
</mvc:View>
