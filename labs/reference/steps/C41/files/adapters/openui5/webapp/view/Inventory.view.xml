<mvc:View controllerName="course.inventory.controller.Inventory" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns="sap.m" displayBlock="true" height="100%">
  <Page title="{i18n>appTitle}"><content><VBox class="sapUiSmallMargin">
    <!-- region toolbar -->
    <Label text="{i18n>language}" labelFor="language" />
    <Select id="language" selectedKey="{ui>/language}" change=".onLanguageChange">
      <core:Item key="zh-CN" text="中文" /><core:Item key="en" text="English" />
    </Select>
    <Text text="{i18n>restartNote}" />
    <Label text="{i18n>search}" labelFor="search" />
    <SearchField id="search" value="{ui>/query}" search=".onFilter" />
    <Text text="{ui>/message}" />
    <HBox wrap="Wrap">
      <Text text="{i18n>visibleCount}" /><Text id="count" text="{ui>/count}" />
      <Text text="{i18n>totalStock}" /><Text id="totalStock" text="{ui>/stock}" />
      <Text text="{i18n>totalValue}" /><Text id="totalValue" text="{path: 'ui>/valueCents', formatter: '.formatter.money'}" />
    </HBox>
    <HBox><Text text="{i18n>allStock}" /><Text id="allStock" text="{ui>/allStock}" /></HBox>
    <!-- endregion toolbar -->
    <!-- region table -->
    <Table id="products" items="{inventory>/products}" updateFinished=".onUpdateFinished" noDataText="{i18n>noProducts}">
      <columns>
        <Column><Text text="{i18n>product}" /></Column>
        <Column><Text text="{i18n>stock}" /></Column>
        <Column><Text text="{i18n>actions}" /></Column>
      </columns>
      <items><ColumnListItem><cells>
        <ObjectIdentifier title="{inventory>name}" text="{inventory>id}" />
        <ObjectNumber number="{inventory>stock}" />
        <Button text="{i18n>edit}" press=".onEdit" />
      </cells></ColumnListItem></items>
    </Table>
    <!-- endregion table -->
  </VBox></content></Page>
</mvc:View>
