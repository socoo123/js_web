<mvc:View controllerName="course.inventory.controller.Detail"
  xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" displayBlock="true" height="100%">
  <Page title="{i18n>detailTitle}" showNavButton="true" navButtonPress=".onList"><content>
    <VBox class="sapUiSmallMargin">
      <Button text="{i18n>backToList}" press=".onList" />
      <Text text="{i18n>detailLoading}" visible="{= %{detail>/status} === 'loading' }" />
      <Text text="{i18n>detailError}" visible="{= %{detail>/status} === 'error' }" />
      <Text text="{i18n>notFound}" visible="{= %{detail>/status} === 'missing' }" />
      <Text text="{i18n>routeMissing}" visible="{= %{detail>/status} === 'routeMissing' }" />
      <VBox visible="{= %{detail>/status} === 'found' }">
        <ObjectIdentifier title="{inventory>name}" text="{inventory>id}" />
        <Label text="{i18n>stock}" /><ObjectNumber id="detailStock" number="{inventory>stock}" />
      </VBox>
    </VBox>
  </content></Page>
</mvc:View>
