---
import catalog from '../../labs/catalog.json';
import { stepsForLesson, returnsForLesson, lessonTabHref } from '../lib/lab-steps.mjs';
import './lab-ui.css';
interface Props { lessonId: string }
const row = catalog.lessons.find((lesson) => lesson.lessonId === Astro.props.lessonId);
if (!row) throw new Error(`catalog 中没有 ${Astro.props.lessonId}`);
const lab = catalog.labs.find((item) => item.labId === row.labId)!;
const base = import.meta.env.BASE_URL;
const own = stepsForLesson(row.lessonId);
const first = own?.steps[0];
const last = own?.steps.at(-1);
const range = own && first && last ? (first === last ? `第 ${first.number} 步` : `第 ${first.number}–${last.number} 步`) : '';
// 「返回 Lab」直接打开 Lab 页里本课的标签；从「先读」进入时，返回浮标仍回到具体步骤。
const href = lessonTabHref(base, lab.labId, row.lessonId);
const returns = returnsForLesson(row.lessonId, base);
---
<nav class="lab-bar lab-ui not-content" data-lab-bar={row.lessonId} aria-label="所属 Lab">
  <a class="lab-chip" href={href}>
    <span class="lab-id">{lab.labId}</span>
    {own ? <span class="lab-where">{range} / 共 {own.lab.steps.length} 步</span> : <span class="lab-where">{lab.title}</span>}
    <span class="lab-back">返回 Lab</span>
  </a>
  {own && <span class="lab-status" data-lab-progress data-ids={own.steps.map((step) => step.stepId).join(' ')} data-unit="步" data-lab-js hidden>本课<span data-lab-progress-count></span></span>}
</nav>
{Object.keys(returns).length > 0 && (
  <aside class="lab-return lab-ui not-content" data-lab-return data-returns={JSON.stringify(returns)} aria-label="回到 Lab 步骤" hidden>
    <a data-lab-return-link href={href}>
      <span aria-hidden="true">←</span>
      <span class="return-text"><strong data-lab-return-text>返回 Lab</strong><span data-lab-return-title></span></span>
    </a>
    <button type="button" data-lab-return-close aria-label="关闭返回提示"><span aria-hidden="true">×</span></button>
  </aside>
)}

<script>
  import '../scripts/lab-progress.mjs';
</script>

<style>
  .lab-bar {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 0.85rem;
    margin-block: 0 1rem; font-size: var(--sl-text-sm); line-height: 1.5;
  }
  .lab-chip, .lab-chip:visited {
    display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.5rem;
    min-height: 2.5rem; padding: 0.3rem 0.9rem 0.3rem 0.35rem;
    border: 1px solid color-mix(in srgb, var(--js-color-amber-stroke) 45%, var(--js-border)); border-radius: 999px;
    background: var(--js-surface-raised); color: var(--js-color-heading); text-decoration: none;
    transition: border-color var(--js-motion) var(--js-ease), background-color var(--js-motion) var(--js-ease);
  }
  .lab-chip:hover {
    border-color: var(--js-color-amber-stroke); background: var(--js-color-amber-soft); color: var(--js-color-heading);
  }
  .lab-id {
    padding: 0 0.45rem; border-radius: 999px;
    background: var(--js-color-amber-stroke); color: #1c1300;
    font-size: 0.75rem; font-weight: 800; line-height: 1.5rem;
  }
  .lab-where { font-variant-numeric: tabular-nums; }
  .lab-back { color: var(--js-color-primary); font-weight: 650; text-underline-offset: 0.22em; }
  .lab-back::before { content: '· '; color: var(--js-color-muted); font-weight: 400; }
  .lab-chip:hover .lab-back { text-decoration: underline; }
  .lab-status { color: var(--js-color-muted); font-variant-numeric: tabular-nums; }

  .lab-return {
    position: fixed; z-index: calc(var(--sl-z-index-menu, 5) - 1);
    inset-inline: 0.75rem; inset-block-end: max(0.75rem, env(safe-area-inset-bottom));
    display: flex; align-items: stretch; gap: 0.25rem;
    max-width: 26rem; margin-inline: auto; padding: 0.3rem;
    border: 1px solid color-mix(in srgb, var(--js-color-primary) 45%, var(--js-border)); border-radius: var(--js-radius);
    background: var(--js-surface-raised); box-shadow: var(--js-shadow);
    animation: lab-return-in var(--js-motion) var(--js-ease);
  }
  @keyframes lab-return-in { from { opacity: 0; transform: translateY(0.5rem); } }
  /* 所有宽度都在底部居中：右侧目录是 fixed 且在主栏的层叠上下文之外，靠右放会被它挡住关闭按钮 */
  .lab-return a, .lab-return a:visited {
    flex: 1; min-width: 0; display: flex; align-items: center; gap: 0.6rem;
    min-height: 2.75rem; padding: 0.25rem 0.9rem; border-radius: 10px;
    background: var(--js-color-primary-solid); color: var(--js-color-on-primary); text-decoration: none;
    transition: background-color var(--js-motion) var(--js-ease);
  }
  .lab-return a:hover { background: color-mix(in srgb, var(--js-color-primary-solid) 86%, #000); color: var(--js-color-on-primary); }
  .return-text { display: grid; min-width: 0; line-height: 1.3; }
  .return-text strong { color: inherit; }
  .return-text span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--sl-text-xs); }
  .lab-return button {
    flex: none; width: 2.75rem; border: 0; border-radius: 10px; background: transparent;
    color: var(--js-color-muted); font-size: 1.25rem; cursor: pointer;
    transition: background-color var(--js-motion) var(--js-ease), color var(--js-motion) var(--js-ease);
  }
  .lab-return button:hover { background: var(--js-color-primary-soft); color: var(--js-color-heading); }
  :global(html.has-lab-return) :global(.main-frame) { padding-bottom: 5rem; }
</style>
