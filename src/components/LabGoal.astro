---
import LabShot from './LabShot.astro';
import { labFor, demoFor, stepAnchor } from '../lib/lab-steps.mjs';
import { inlineHtml } from '../../labs/steps/model.mjs';
interface Props { labId: string }
const lab = labFor(Astro.props.labId);
if (!lab) throw new Error(`没有 ${Astro.props.labId} 的步骤数据`);
const base = import.meta.env.BASE_URL;
const demo = lab.goal.demo ? demoFor(lab.goal.demo) : undefined;
---
<section class="lab-goal" data-lab-goal={lab.labId} aria-labelledby={`${lab.labId.toLowerCase()}-goal-title`}>
  <div class="goal-text">
    <p class="kicker">{lab.labId} · {lab.lessons[0]}–{lab.lessons.at(-1)} · {lab.lessons.length} 课 · {lab.steps.length} 步</p>
    <p class="title" id={`${lab.labId.toLowerCase()}-goal-title`}>完成后的样子</p>
    <p set:html={inlineHtml(lab.goal.summary, base)} />
    <ul>{lab.goal.outcomes.map((item) => <li set:html={inlineHtml(item, base)} />)}</ul>
    <p class="actions">
      {demo && <a class="button primary" href={`${base}${demo.path}`}>打开在线目标演示</a>}
      <a class="button" href={`#${stepAnchor(lab.steps[0].stepId)}`}>从第 1 步开始</a>
    </p>
    {demo && <p class="note">在线演示是 {demo.checkpoint} 完成态的静态构建，只用浏览器内的模拟数据。</p>}
  </div>
  {lab.goal.shot && <div class="goal-shot"><LabShot id={lab.goal.shot} variant="goal" caption={`${demo?.checkpoint ?? lab.lessons.at(-1)} 完成后的库存应用`} /></div>}
</section>

<style>
  .lab-goal {
    display: grid; gap: 1.25rem; align-items: start;
    margin-block: 1.5rem;
    padding: 1.25rem;
    border: 1px solid var(--js-color-primary, var(--sl-color-text-accent));
    border-radius: var(--js-radius, 0.75rem);
    background: linear-gradient(160deg, var(--js-color-primary-soft, var(--sl-color-accent-low)), transparent 70%), var(--js-surface-raised, var(--sl-color-bg-nav));
    box-shadow: var(--js-shadow, none);
  }
  @media (min-width: 60rem) { .lab-goal { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); } }
  .goal-text > * { margin: 0.5rem 0 0; }
  .goal-text > :first-child { margin-top: 0; }
  .kicker { font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); font-variant-numeric: tabular-nums; }
  .title { font-size: var(--sl-text-h3); font-weight: 700; line-height: 1.3; color: var(--sl-color-white); }
  ul { padding-inline-start: 1.25rem; }
  li + li { margin-top: 0.3rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1rem !important; }
  .button {
    display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0.5rem 1rem;
    border: 1px solid var(--js-color-primary, var(--sl-color-text-accent)); border-radius: 999px;
    color: var(--sl-color-white); text-decoration: none; font-weight: 600;
  }
  .button.primary { background: var(--js-color-primary, var(--sl-color-text-accent)); color: var(--js-surface, var(--sl-color-black)); }
  .button:hover { box-shadow: 0 0 0 3px var(--js-color-primary-soft, var(--sl-color-accent-low)); }
  .button:focus-visible { outline: 2px solid var(--js-color-primary, var(--sl-color-text-accent)); outline-offset: 3px; }
  .note { font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); }
</style>
