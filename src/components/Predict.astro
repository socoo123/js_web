---
// 「先猜一猜」：问题 + 代码 + 点击揭晓的答案。答案区 summary 固定为「揭晓答案」，「提示」「参考答案」留给练习。
interface Props { question: string }
const { question } = Astro.props;
---
<section class="js-callout predict" data-callout="predict" data-predict aria-label={`先猜一猜：${question}`}>
  <p class="predict-label"><span class="predict-icon" aria-hidden="true">?</span>先猜一猜</p>
  <p class="predict-question">{question}</p>
  <div class="predict-body"><slot /></div>
  <details class="predict-answer">
    <summary><span class="when-closed">揭晓答案</span><span class="when-open">收起答案</span></summary>
    <div class="predict-answer-body"><slot name="answer" /></div>
  </details>
</section>

<style>
  .predict {
    border: 1px solid var(--js-border, var(--sl-color-hairline-light));
    border-inline-start: 4px solid var(--js-color-amber, var(--sl-color-orange));
    border-radius: var(--js-radius, 12px);
    background: var(--js-color-amber-soft, var(--sl-color-orange-low));
    padding: .9rem 1.1rem 1rem;
    margin-block: 1.5rem;
  }
  .predict > :global(* + *) { margin-top: .6rem; }
  .predict-label {
    display: flex; align-items: center; gap: .45rem; margin: 0;
    font-size: .85rem; font-weight: 700; letter-spacing: .04em;
    color: var(--js-color-amber, var(--sl-color-orange-high));
  }
  .predict-icon {
    display: inline-grid; place-items: center; inline-size: 1.35rem; block-size: 1.35rem; border-radius: 50%;
    background: var(--js-color-amber, var(--sl-color-orange)); color: var(--sl-color-black, #fff); font-size: .8rem;
  }
  .predict-question { font-weight: 600; margin-top: .35rem; }
  .predict-answer {
    border-top: 1px dashed var(--js-border, var(--sl-color-hairline-light));
    padding-top: .6rem;
  }
  .predict-answer summary {
    display: inline-flex; align-items: center; gap: .4rem; cursor: pointer;
    font-weight: 600; color: var(--js-color-primary, var(--sl-color-text-accent));
    border-radius: 6px; padding: .2rem .5rem; margin-inline-start: -.5rem;
  }
  .predict-answer summary::marker { content: ''; }
  .predict-answer summary::-webkit-details-marker { display: none; }
  .predict-answer summary::before { content: '▸'; transition: transform var(--js-motion, 200ms); }
  .predict-answer[open] summary::before { transform: rotate(90deg); }
  .predict-answer summary:hover { background: var(--js-color-primary-soft, var(--sl-color-accent-low)); }
  .predict-answer summary:focus-visible { outline: 2px solid var(--js-color-primary, var(--sl-color-text-accent)); outline-offset: 2px; }
  .predict-answer[open] .when-closed, .predict-answer:not([open]) .when-open { display: none; }
  .predict-answer-body { margin-top: .5rem; }
  .predict-answer[open] .predict-answer-body { animation: predict-reveal var(--js-motion, 200ms) ease-out; }
  .predict-answer-body > :global(* + *) { margin-top: .6rem; }
  @keyframes predict-reveal { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .predict-answer[open] .predict-answer-body { animation: none; }
    .predict-answer summary::before { transition: none; }
  }
</style>
