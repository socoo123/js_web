---
import catalog from '../../labs/catalog.json';
interface Props { checkpoint?: string; manifest?: boolean; label?: string }
const { checkpoint = 'C00', manifest = false, label } = Astro.props;
if (!/^[CP]\d{2}$/.test(checkpoint)) throw new Error('未知快照');
const href = `${import.meta.env.BASE_URL}downloads/inventory/${catalog.release}/${manifest ? 'manifest.json' : checkpoint + '.tar.gz'}`;
---
<a href={href}>{label ?? (manifest ? `${catalog.release} 校验清单` : `${checkpoint} 学习包`)}</a>
