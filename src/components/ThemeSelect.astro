---
import Select from '@astrojs/starlight/components/Select.astro';
---

<starlight-theme-select>
  <Select
    icon="laptop"
    label={Astro.locals.t('themeSelect.accessibleLabel')}
    options={[
      { label: Astro.locals.t('themeSelect.dark'), selected: false, value: 'dark' },
      { label: Astro.locals.t('themeSelect.light'), selected: false, value: 'light' },
      { label: Astro.locals.t('themeSelect.auto'), selected: true, value: 'auto' },
    ]}
    width="6.25em"
  />
</starlight-theme-select>
<script is:inline>StarlightThemeProvider.updatePickers();</script>
<script>
  type Theme = 'auto' | 'light' | 'dark';
  let current: Theme = 'auto';
  const parse = (value: unknown): Theme => value === 'light' || value === 'dark' ? value : 'auto';
  try { current = parse(localStorage.getItem('starlight-theme')); } catch {}
  function apply(theme: Theme) {
    current = theme;
    document.documentElement.dataset.theme = theme === 'auto'
      ? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
      : theme;
    StarlightThemeProvider.updatePickers(theme);
    try { localStorage.setItem('starlight-theme', theme === 'auto' ? '' : theme); } catch {}
  }
  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (current === 'auto') apply('auto');
  });
  customElements.define('starlight-theme-select', class extends HTMLElement {
    constructor() {
      super();
      apply(current);
      this.querySelector('select')?.addEventListener('change', (event) => {
        if (event.currentTarget instanceof HTMLSelectElement) apply(parse(event.currentTarget.value));
      });
    }
  });
</script>
