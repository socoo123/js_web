---
import { getEntry, render } from 'astro:content';
import { Code } from '@astrojs/starlight/components';
import LabShot from './LabShot.astro';
import { labFor, stepAnchor, finishAnchor, readLabel } from '../lib/lab-steps.mjs';
import { inlineHtml, readHref } from '../../labs/steps/model.mjs';
import './lab-ui.css';
interface Props { labId: string }
const lab = labFor(Astro.props.labId);
if (!lab) throw new Error(`没有 ${Astro.props.labId} 的步骤数据`);
const base = import.meta.env.BASE_URL;
const html = (text: string) => inlineHtml(text, base);
const slugs = [...new Set(lab.steps.flatMap((step) => step.read.map((item) => item.slug)))];
const headings = new Map(await Promise.all(slugs.map(async (slug) => {
  const entry = await getEntry('docs', slug);
  if (!entry) throw new Error(`「先读」页面不存在：${slug}`);
  return [slug, (await render(entry)).headings] as const;
})));
const ids = lab.steps.map((step) => step.stepId);
const targets = Object.fromEntries(lab.steps.map((step) => [step.stepId, { href: `#${stepAnchor(step.stepId)}`, text: `继续第 ${step.number} 步：${step.title}` }]));
const lastOf = (lessonId: string) => lab.steps.filter((step) => step.lessonId === lessonId).at(-1)!.number;
---
<section class="lab-steps lab-ui not-content" data-lab-steps={lab.labId} data-lab-root aria-label={`${lab.labId} 步骤`}>
  <div class="steps-head" data-lab-progress data-ids={ids.join(' ')} data-unit="步">
    <div class="ring" data-lab-progress-ring data-lab-js hidden aria-hidden="true"><span data-lab-progress-ratio>0/{ids.length}</span></div>
    <div class="steps-head-text">
      <p class="steps-total"><strong>{lab.steps.length} 步</strong> · {lab.lessons.length} 课（{lab.lessons[0]}–{lab.lessons.at(-1)}） · 每课 1–3 步</p>
      <p data-lab-js hidden>
        <span data-lab-progress-count></span> ·
        <a data-lab-progress-next data-targets={JSON.stringify(targets)} data-done-href={`#${finishAnchor(lab.labId)}`} data-done-text="步骤都已勾选，去收尾清单" href={`#${stepAnchor(ids[0])}`}>从第 1 步开始</a>
      </p>
      <p class="lab-note">勾选「我已完成这一步」只记录你自己的确认，保存在当前浏览器，不代表本地检查已通过；检查是否通过以终端输出为准。</p>
      <p data-lab-progress-state hidden></p>
    </div>
  </div>

  <ol class="steps">
    {lab.steps.map((step) => {
      const anchor = stepAnchor(step.stepId);
      return (
        <li class="step" id={anchor} data-lab-step-item>
          <span class="step-number" aria-hidden="true">{step.number}</span>
          <article class="step-card" data-lab-scope aria-labelledby={`${anchor}-title`}>
            <p class="step-meta"><a href={`${base}${step.lesson.slug}/`}>{step.lessonId} {step.lesson.title}</a><span> · 本课第 {step.lessonStep} / {step.lessonSteps} 步</span></p>
            <h3 id={`${anchor}-title`}>第 {step.number} 步 · {step.title}</h3>
            <p class="step-goal" set:html={html(step.goal)} />

            <div class="block">
              <p class="lab-label" id={`${anchor}-read`}>先读</p>
              <ul class="read" aria-labelledby={`${anchor}-read`}>
                {step.read.map((item) => (
                  <li>
                    <a href={readHref(base, item, step.stepId)}><span class="read-lesson">{item.lessonId}</span> {readLabel(item, headings.get(item.slug))}</a>
                    <span class="why" set:html={html(item.why)} />
                  </li>
                ))}
              </ul>
            </div>

            <div class="block">
              <p class="lab-label" id={`${anchor}-files`}>改动文件</p>
              <ul class="lab-files" aria-labelledby={`${anchor}-files`}>{step.files.map((file) => <li><code>{file}</code></li>)}</ul>
            </div>

            <div class="block">
              <p class="lab-label" id={`${anchor}-actions`}>动手</p>
              <ol class="actions" aria-labelledby={`${anchor}-actions`}>{step.actions.map((action) => <li set:html={html(action)} />)}</ol>
            </div>

            <div class="block">
              <p class="lab-label">应该看到</p>
              {step.preview.shot
                ? <LabShot id={step.preview.shot} caption={step.preview.caption} />
                : <figure class="output"><pre><code>{step.preview.output}</code></pre>{step.preview.caption && <figcaption set:html={html(step.preview.caption)} />}</figure>}
            </div>

            <div class="block">
              <p class="lab-label" id={`${anchor}-accept`}>验收</p>
              <ul class="accept" aria-labelledby={`${anchor}-accept`}>{step.acceptance.map((item) => <li set:html={html(item)} />)}</ul>
            </div>

            <div class="block">
              <p class="lab-label">{step.defaultCheck && !step.lastOfLesson ? `本课检查（做完第 ${lastOf(step.lessonId)} 步后才会通过）` : '检查命令'}</p>
              <Code code={step.check.join('\n')} lang="sh" />
            </div>

            {step.hint && <details class="lab-fold" data-disclosure="hint"><summary>提示</summary><p set:html={html(step.hint)} /></details>}
            {step.answer && <details class="lab-fold" data-disclosure="answer"><summary>参考答案</summary><p set:html={html(step.answer)} /></details>}

            <label class="done" data-lab-js hidden>
              <input type="checkbox" data-lab-step-toggle={step.stepId} data-label={`第 ${step.number} 步`} />
              <span>我已完成这一步</span>
            </label>
            <p class="message" data-lab-message role="status" aria-live="polite"></p>
          </article>
        </li>
      );
    })}
  </ol>
  <noscript><p class="lab-note">启用 JavaScript 后可以勾选步骤并保存进度；步骤内容不受影响。</p></noscript>
</section>

<script>
  import '../scripts/lab-progress.mjs';
</script>

<style>
  .lab-steps { max-width: calc(var(--js-prose-width) + 3rem); margin-block: 1.5rem 2.5rem; }
  .steps-head {
    display: flex; gap: 1rem; align-items: center; padding: 1rem 1.25rem;
    border: 1px solid var(--js-border); border-radius: var(--js-radius);
    background: var(--js-surface-raised); box-shadow: var(--js-shadow);
  }
  .steps-head-text > * + * { margin-top: 0.3rem; }
  .steps-total { color: var(--js-color-heading); }
  .ring {
    --done: 0;
    flex: none; display: grid; place-items: center;
    width: 4.25rem; aspect-ratio: 1; border-radius: 50%;
    background: conic-gradient(var(--js-color-ok) calc(var(--done) * 1turn), var(--js-border) 0);
  }
  .ring span {
    display: grid; place-items: center; width: 3.25rem; aspect-ratio: 1; border-radius: 50%;
    background: var(--js-surface-raised); color: var(--js-color-heading);
    font-size: var(--sl-text-sm); font-variant-numeric: tabular-nums; font-weight: 650;
  }

  .steps { list-style: none; padding: 0; margin-top: 1.5rem; }
  .step {
    position: relative; display: grid; grid-template-columns: 2.25rem minmax(0, 1fr); gap: 0.75rem;
    margin: 0; padding-bottom: 1.25rem;
    scroll-margin-top: calc(var(--sl-nav-height, 3.5rem) + var(--sl-mobile-toc-height, 0rem) + 1rem);
  }
  .step + .step { margin-top: 0; }
  .step::before {
    content: ''; position: absolute; inset-block: 2.5rem 0; inset-inline-start: calc(1.125rem - 1px); width: 2px;
    background: var(--js-border);
  }
  .step:last-child::before { display: none; }
  .step-number {
    display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 50%;
    border: 2px solid color-mix(in srgb, var(--js-color-primary) 60%, var(--js-border));
    background: var(--js-surface); color: var(--js-color-heading);
    font-weight: 700; font-variant-numeric: tabular-nums; font-size: var(--sl-text-sm);
    transition: background-color var(--js-motion) var(--js-ease), border-color var(--js-motion) var(--js-ease), color var(--js-motion) var(--js-ease);
  }
  .step.is-done .step-number { border-color: var(--js-color-ok); background: var(--js-color-ok); color: var(--js-surface); }
  .step-card {
    min-width: 0; padding: 1rem 1.25rem;
    border: 1px solid var(--js-border); border-radius: var(--js-radius);
    background: var(--js-surface-raised);
    transition: border-color var(--js-motion) var(--js-ease), box-shadow var(--js-motion) var(--js-ease);
  }
  .step-card:hover { border-color: color-mix(in srgb, var(--js-color-primary) 35%, var(--js-border)); }
  .step:target .step-card {
    border-color: var(--js-color-primary);
    box-shadow: 0 0 0 3px var(--js-color-primary-soft), var(--js-shadow);
  }
  .step.is-done .step-card { border-color: color-mix(in srgb, var(--js-color-ok) 55%, var(--js-border)); }
  .step-meta { font-size: var(--sl-text-sm); color: var(--js-color-muted); }
  h3 { margin: 0.25rem 0 0.5rem; color: var(--js-color-heading); font-size: var(--sl-text-h4); font-weight: 650; line-height: 1.35; }
  .block { margin-top: 0.9rem; }
  .read { list-style: none; padding: 0; display: grid; gap: 0.35rem; }
  .read li { display: grid; gap: 0.1rem; margin: 0; padding: 0.5rem 0.75rem; border-radius: 10px; background: var(--js-color-primary-soft); }
  .read a { font-weight: 650; }
  .read-lesson { font-variant-numeric: tabular-nums; }
  .why { font-size: var(--sl-text-sm); color: var(--js-color-muted); }
  .output pre {
    margin: 0; padding: 0.75rem 1rem; overflow-x: auto;
    border: 1px solid var(--js-border); border-radius: 10px;
    background: var(--js-console-bg); color: var(--js-console-fg);
    font-size: var(--js-code-size); line-height: 1.6;
  }
  .output code { padding: 0; border: 0; background: none; color: inherit; font-size: inherit; white-space: pre; overflow-wrap: normal; }
  .output figcaption { margin-top: 0.4rem; font-size: var(--sl-text-sm); color: var(--js-color-muted); }
  .lab-fold { margin-top: 0.85rem; }
  .lab-fold + .lab-fold { margin-top: 0.6rem; }
  .done {
    display: inline-flex; align-items: center; gap: 0.6rem; margin-top: 1rem;
    min-height: 2.75rem; padding: 0.4rem 0.9rem;
    border: 1px solid var(--js-border); border-radius: 10px; background: var(--js-surface);
    color: var(--js-color-heading); font-weight: 650; cursor: pointer;
    transition: border-color var(--js-motion) var(--js-ease), background-color var(--js-motion) var(--js-ease);
  }
  .done:hover { border-color: color-mix(in srgb, var(--js-color-ok) 55%, var(--js-border)); }
  .done input { width: 1.15rem; height: 1.15rem; margin: 0; accent-color: var(--js-color-ok); }
  .done:has(input:checked) { border-color: color-mix(in srgb, var(--js-color-ok) 55%, var(--js-border)); background: var(--js-color-ok-soft); }
  .done:has(input:disabled) { opacity: 0.6; cursor: not-allowed; }
  .message { margin-top: 0.5rem; }
  @media (max-width: 30rem) {
    .step { grid-template-columns: minmax(0, 1fr); }
    .step::before { display: none; }
    .step-number { position: absolute; inset-block-start: 0.85rem; inset-inline-end: 0.85rem; width: 1.9rem; height: 1.9rem; }
    .step-card { padding: 0.9rem 1rem; }
    .step-card h3 { padding-inline-end: 2.25rem; }
    .steps-head { align-items: flex-start; }
    .ring { width: 3.5rem; }
    .ring span { width: 2.7rem; font-size: var(--sl-text-xs); }
  }
</style>
