---
import { labFor, finishAnchor } from '../lib/lab-steps.mjs';
import { inlineHtml } from '../../labs/steps/model.mjs';
import './lab-ui.css';
interface Props { labId: string }
const lab = labFor(Astro.props.labId);
if (!lab) throw new Error(`没有 ${Astro.props.labId} 的步骤数据`);
const base = import.meta.env.BASE_URL;
const ids = lab.finish.map((item) => item.id);
---
<section class="lab-finish lab-ui not-content" id={finishAnchor(lab.labId)} data-lab-finish={lab.labId} data-lab-root data-lab-scope aria-label={`${lab.labId} 收尾清单`}>
  <p class="head" data-lab-progress data-ids={ids.join(' ')} data-unit="项">
    <strong>收尾清单 · {ids.length} 项</strong>
    <span data-lab-js hidden> · <span data-lab-progress-count></span></span>
  </p>
  <ol>
    {lab.finish.map((item, index) => (
      <li data-lab-step-item>
        <input type="checkbox" id={`${item.id}-check`} data-lab-step-toggle={item.id} data-label={`收尾第 ${index + 1} 项`} data-lab-js hidden />
        <label for={`${item.id}-check`} set:html={inlineHtml(item.text, base)} />
      </li>
    ))}
  </ol>
  <p class="lab-note">勾选只记录你自己的确认，不代表 <code>npm run lab -- check</code> 已通过。</p>
  <p data-lab-progress-state hidden></p>
  <p class="message" data-lab-message role="status" aria-live="polite"></p>
</section>

<script>
  import '../scripts/lab-progress.mjs';
</script>

<style>
  .lab-finish {
    max-width: var(--js-prose-width);
    margin-block: 1rem 1.5rem; padding: 1rem 1.25rem;
    border: 1px solid color-mix(in srgb, var(--js-color-ok) 35%, var(--js-border)); border-radius: var(--js-radius);
    background: var(--js-surface-raised); box-shadow: var(--js-shadow);
    scroll-margin-top: calc(var(--sl-nav-height, 3.5rem) + var(--sl-mobile-toc-height, 0rem) + 1rem);
    transition: border-color var(--js-motion) var(--js-ease), box-shadow var(--js-motion) var(--js-ease);
  }
  .lab-finish:target { border-color: var(--js-color-primary); box-shadow: 0 0 0 3px var(--js-color-primary-soft), var(--js-shadow); }
  .head { color: var(--js-color-heading); font-variant-numeric: tabular-nums; }
  .head span { color: var(--js-color-muted); }
  ol { margin-top: 0.75rem; padding-inline-start: 1.5rem; }
  li { display: flex; gap: 0.65rem; align-items: flex-start; padding: 0.5rem 0.25rem; }
  li + li { margin-top: 0; border-top: 1px solid var(--js-border); }
  ol:has(input:not([hidden])) { list-style: none; padding-inline-start: 0; }
  input { flex: none; width: 1.15rem; height: 1.15rem; margin: 0.3rem 0 0; accent-color: var(--js-color-ok); }
  label { cursor: pointer; transition: color var(--js-motion) var(--js-ease); }
  li.is-done label { color: var(--js-color-muted); }
  .lab-note, [data-lab-progress-state], .message { margin-top: 0.75rem; }
</style>
