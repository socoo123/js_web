---
// Lab 收尾清单：条目来自 labs/steps/lN.json 的 finish，勾选写入学习进度（F1 的 labSteps）。
// 禁用 JS 时是编号列表，勾选框与进度条隐藏。
import { labView, finishAnchor } from '../lib/lab-steps.mjs';
import { inlineHtml } from '../../labs/steps/model.mjs';
import './lab-ui.css';
interface Props { labId: string }
const view = labView(Astro.props.labId);
const base = import.meta.env.BASE_URL;
const ids = view.finish.map((item) => item.id);
const anchor = finishAnchor(view.labId);
---
<section class="lab-finish lab-ui not-content" id={anchor} data-lab-finish={view.labId} data-lab-root data-lab-scope aria-labelledby={`${anchor}-title`}>
  <div class="head" data-lab-progress data-ids={ids.join(' ')} data-unit="项">
    <p class="title" id={`${anchor}-title`}>收尾清单 · {ids.length} 项</p>
    <p class="count" data-lab-js hidden><span data-lab-progress-count></span></p>
    <span class="bar" data-lab-progress-bar data-lab-js hidden aria-hidden="true"><span></span></span>
  </div>
  <ol class="items">
    {view.finish.map((item, index) => (
      <li data-lab-step-item>
        <input type="checkbox" id={`${item.id}-check`} data-lab-step-toggle={item.id} data-label={`收尾第 ${index + 1} 项`} data-lab-js hidden />
        <label for={`${item.id}-check`}><span class="num" aria-hidden="true">{index + 1}</span><span class="text" set:html={inlineHtml(item.text, base)} /></label>
      </li>
    ))}
  </ol>
  <p class="lab-note">勾选只记录你自己的确认，不代表 <code>npm run lab -- check</code> 已通过。</p>
  <p data-lab-progress-state hidden></p>
  <p class="message" data-lab-message role="status" aria-live="polite"></p>
</section>

<script>
  import '../scripts/lab-progress.mjs';
</script>

<style>
  .lab-finish {
    margin-block: 1rem 1.5rem; padding: 1rem 1.25rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--js-color-ok) 35%, var(--js-border)); border-radius: var(--js-radius);
    background: linear-gradient(170deg, var(--js-color-ok-soft), transparent 55%), var(--js-surface-raised);
    box-shadow: var(--js-shadow);
    scroll-margin-top: calc(var(--sl-nav-height, 3.5rem) + var(--sl-mobile-toc-height, 0rem) + 1rem);
    transition: border-color var(--js-motion) var(--js-ease), box-shadow var(--js-motion) var(--js-ease);
  }
  .lab-finish:target { border-color: var(--js-color-primary); box-shadow: 0 0 0 3px var(--js-color-primary-soft), var(--js-shadow); }
  .head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem 0.85rem; }
  .title { color: var(--js-color-heading); font-size: var(--sl-text-lg); font-weight: 700; }
  .count { color: var(--js-color-muted); font-size: var(--sl-text-sm); font-variant-numeric: tabular-nums; }
  .head[data-lab-progress-done] .count { color: var(--js-color-ok); font-weight: 650; }
  .bar {
    --done: 0;
    flex-basis: 100%; height: 0.375rem; overflow: hidden; border-radius: 999px;
    background: color-mix(in srgb, var(--js-border) 85%, transparent);
  }
  .bar[hidden] { display: none; }
  .bar span {
    display: block; height: 100%; width: calc(var(--done) * 100%); border-radius: inherit; background: var(--js-color-ok);
    transition: width var(--js-motion) var(--js-ease);
  }
  .items { margin-top: 0.85rem; padding: 0; list-style: none; display: grid; gap: 0.45rem; }
  .items li {
    display: flex; gap: 0.7rem; align-items: flex-start; margin: 0; padding: 0.6rem 0.8rem;
    border: 1px solid var(--js-border); border-radius: 10px; background: var(--js-surface);
    transition: border-color var(--js-motion) var(--js-ease), background-color var(--js-motion) var(--js-ease);
  }
  .items li:has(input:not([hidden])):hover { border-color: color-mix(in srgb, var(--js-color-ok) 50%, var(--js-border)); }
  input { flex: none; width: 1.2rem; height: 1.2rem; margin: 0.25rem 0 0; accent-color: var(--js-color-ok); cursor: pointer; }
  input:disabled { cursor: not-allowed; }
  label { display: flex; gap: 0.6rem; align-items: flex-start; min-width: 0; cursor: pointer; transition: color var(--js-motion) var(--js-ease); }
  .num {
    flex: none; display: grid; place-items: center; width: 1.5rem; height: 1.5rem; margin-top: 0.1rem; border-radius: 50%;
    background: var(--js-color-primary-soft); color: var(--js-color-primary); font-size: 0.75rem; font-weight: 800; font-variant-numeric: tabular-nums;
  }
  li.is-done { border-color: color-mix(in srgb, var(--js-color-ok) 45%, var(--js-border)); background: var(--js-color-ok-soft); }
  li.is-done .num { background: var(--js-color-ok); color: var(--js-surface); }
  li.is-done .text { color: var(--js-color-muted); }
  .lab-note, [data-lab-progress-state], .message { margin-top: 0.75rem; }
</style>
