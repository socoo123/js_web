---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import LearningProgress from './LearningProgress.astro';
import LessonHeader from './LessonHeader.astro';
import LabBar from './LabBar.astro';
import LabNext from './LabNext.astro';

const { id, entry } = Astro.locals.starlightRoute;
const lessonId = entry.data.title.match(/^(C\d{2})\s/)?.[1];
const labPage = /^labs(?:\/l[1-5])?$/.test(id);
// 课页、Lab 页和速查页放宽到 --js-wide-width；base.css 通过 html:has([data-page-kind]) 读取。
const pageKind = lessonId ? 'lesson' : labPage ? 'lab' : id.startsWith('reference/') ? 'reference' : id === '404' ? 'not-found' : undefined;
---

{pageKind && <span class="page-kind" data-page-kind={pageKind} hidden></span>}
{lessonId && <span data-reveal-lesson={lessonId} hidden></span>}
{id === '404' && (
  <p class="not-found-art not-content" aria-hidden="true">
    4<svg viewBox="0 0 24 24"><path d="M21 8 12 3 3 8v8l9 5 9-5z" /><path d="m3 8 9 5 9-5M12 13v8" /></svg>4
  </p>
)}
{id === 'roadmap' && <LearningProgress />}
{lessonId && entry.data.lesson && <LessonHeader lessonId={lessonId} lesson={entry.data.lesson} />}
{lessonId && <LabBar lessonId={lessonId} />}
<Default><slot /></Default>
{lessonId && <LabNext lessonId={lessonId} />}

<script>
  import '../scripts/reveal.mjs';
</script>
