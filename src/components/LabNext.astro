---
import catalog from '../../labs/catalog.json';
import LearningProgress from './LearningProgress.astro';
import { stepsForLesson, nextAfterLesson, labHref, stepAnchor, finishAnchor, lessonTabHref } from '../lib/lab-steps.mjs';
import './lab-ui.css';
interface Props { lessonId: string }
const { lessonId } = Astro.props;
const row = catalog.lessons.find((lesson) => lesson.lessonId === lessonId);
if (!row) throw new Error(`catalog 中没有 ${lessonId}`);
const lab = catalog.labs.find((item) => item.labId === row.labId)!;
const base = import.meta.env.BASE_URL;
const own = stepsForLesson(lessonId);
const next = nextAfterLesson(lessonId);
const first = own?.steps[0];
const last = own?.steps.at(-1);
const range = first && last ? (first === last ? `第 ${first.number} 步` : `第 ${first.number}–${last.number} 步`) : '';
// 没有步骤数据的 Lab：回到 Lab 页下一课的标签；本课是最后一课时去收尾清单。
const siblings = catalog.lessons.filter((lesson) => lesson.labId === row.labId);
const following = siblings[siblings.indexOf(row) + 1];
const back = following
  ? { href: lessonTabHref(base, lab.labId, following.lessonId), label: '回到 Lab 下一课', title: `${following.lessonId} ${following.title}` }
  : { href: labHref(base, lab.labId, finishAnchor(lab.labId)), label: '回到 Lab 收尾', title: `${lab.labId} 收尾清单 · 逐项核对后勾选` };
---
<nav class="lab-next lab-ui not-content js-card" data-lab-next-step={lessonId} aria-label="回到 Lab">
  {own && first && next ? (
    <>
      <p class="where">
        本课是 <a href={labHref(base, lab.labId, stepAnchor(first.stepId))}>{lab.labId} {range}</a>
        <span data-lab-progress data-ids={own.steps.map((step) => step.stepId).join(' ')} data-unit="步" data-lab-js hidden> · 本课<span data-lab-progress-count></span></span>
      </p>
      {next.step
        ? <a class="go" href={labHref(base, lab.labId, stepAnchor(next.step.stepId))}><span class="go-label">回到 Lab 下一步</span><span class="go-title">第 {next.step.number} 步 · {next.step.lessonId} {next.step.title}</span></a>
        : <a class="go" href={labHref(base, lab.labId, finishAnchor(lab.labId))}><span class="go-label">回到 Lab 收尾</span><span class="go-title">{lab.labId} 收尾清单 · 逐项核对后勾选</span></a>}
    </>
  ) : (
    <>
      <p class="where">本课属于 <a href={lessonTabHref(base, lab.labId, row.lessonId)}>{lab.labId} {lab.title}</a></p>
      <a class="go" href={back.href}><span class="go-label">{back.label}</span><span class="go-title">{back.title}</span></a>
    </>
  )}
</nav>
<LearningProgress lessonId={lessonId} />

<script>
  import '../scripts/lab-progress.mjs';
</script>

<style>
  .lab-next { margin-block: 2.5rem 0; padding: 1rem 1.25rem; }
  .where { margin: 0 0 0.75rem; font-size: var(--sl-text-sm); color: var(--js-color-muted); font-variant-numeric: tabular-nums; }
  .where a, .where a:visited, .where a:hover { color: var(--js-color-primary); font-weight: 650; }
  .go, .go:visited {
    display: grid; gap: 0.15rem; padding: 0.75rem 1rem;
    border: 1px solid color-mix(in srgb, var(--js-color-primary) 45%, var(--js-border)); border-radius: 10px;
    background: var(--js-color-primary-soft); color: var(--js-color-heading); text-decoration: none;
    transition: border-color var(--js-motion) var(--js-ease), box-shadow var(--js-motion) var(--js-ease);
  }
  .go:hover { border-color: var(--js-color-primary); box-shadow: var(--js-shadow); color: var(--js-color-heading); }
  .go-label { font-size: var(--sl-text-sm); font-weight: 700; color: var(--js-color-primary); }
  .go-label::after { content: '→'; display: inline-block; margin-inline-start: 0.3em; transition: transform var(--js-motion) var(--js-ease); }
  .go:hover .go-label::after { transform: translateX(0.2rem); }
  .go-title { font-weight: 650; }
  .lab-next + :global(.learning-progress) { margin-top: 1rem; }
</style>
