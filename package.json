{
  "name": "java-to-javascript-course",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.0",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "astro dev",
    "sync:roadmap": "node scripts/sync-roadmap.mjs",
    "check": "astro check",
    "lint:lessons": "node scripts/lint-lessons.mjs",
    "examples": "node scripts/run-examples.mjs",
    "test:progress": "node --test tests/progress.test.mjs tests/lab-steps.test.mjs",
    "test:progress:browser": "node tests/progress.browser.mjs",
    "build": "npm run build:labs && npm run test:labs && npm run test:api && npm run test:comparisons && npm run lint:lessons && npm run examples && npm run check:capstone && npm run test:progress && npm run check:previews && npm run sync:roadmap && npm run build:demos && astro build && npm run check:build && npm run check:steps",
    "check:build": "node scripts/check-build.mjs",
    "preview": "astro preview",
    "test:labs": "node --test tests/labs.test.mjs tests/lesson-sources.test.mjs tests/lint-lessons.test.mjs tests/reveal-rules.test.mjs",
    "build:labs": "node scripts/build-labs.mjs",
    "test:comparisons": "node scripts/verify-comparisons.mjs",
    "test:lab-walkthrough": "node scripts/verify-l1-walkthrough.mjs && node scripts/verify-lab-walkthrough.mjs",
    "test:lab-react": "node scripts/verify-react-lab.mjs",
    "test:lab-ui5": "node scripts/verify-ui5-lab.mjs",
    "test:lab-delivery": "node scripts/verify-delivery-lab.mjs",
    "check:steps": "node scripts/check-lab-steps.mjs",
    "test:lab-steps:browser": "node tests/lab-steps.browser.mjs",
    "capture:previews": "node scripts/capture-previews.mjs",
    "check:previews": "node scripts/check-previews.mjs",
    "build:demos": "node scripts/build-demos.mjs",
    "test:demos": "node scripts/build-demos.mjs --verify",
    "test:reveal:browser": "node tests/reveal.browser.mjs",
    "check:capstone": "node scripts/check-capstone.mjs",
    "test:api": "node scripts/build-server-rules.mjs --check && node --test labs/inventory/server/test/"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "@astrojs/react": "7.1.4",
    "@astrojs/starlight": "0.42.6",
    "astro": "7.3.8",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "postcss-nested": {
      "postcss-selector-parser": "7.1.6"
    }
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "typescript": "6.0.3",
    "unified": "11.0.5"
  }
}
