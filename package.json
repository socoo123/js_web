{
  "name": "java-to-javascript-course",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.0",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "astro dev",
    "setup:diagrams": "bash scripts/setup-diagrams.sh",
    "diagrams": "bash scripts/build-diagrams.sh",
    "sync:roadmap": "node scripts/sync-roadmap.mjs",
    "check": "astro check",
    "lint:lessons": "node scripts/lint-lessons.mjs",
    "examples": "node scripts/run-examples.mjs",
    "test:progress": "node --test tests/progress.test.mjs",
    "test:progress:browser": "node tests/progress.browser.mjs",
    "build": "npm run build:labs && npm run test:labs && npm run test:comparisons && npm run lint:lessons && npm run examples && npm run test:progress && npm run sync:roadmap && npm run diagrams && astro build && npm run check:build",
    "check:build": "node scripts/check-build.mjs",
    "preview": "astro preview",
    "test:labs": "node --test tests/labs.test.mjs tests/lesson-sources.test.mjs",
    "build:labs": "node scripts/build-labs.mjs",
    "test:comparisons": "node scripts/verify-comparisons.mjs",
    "test:lab-walkthrough": "node scripts/verify-lab-walkthrough.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.6",
    "@astrojs/markdown-remark": "7.3.2",
    "astro": "7.3.8"
  },
  "overrides": {
    "postcss-nested": {
      "postcss-selector-parser": "7.1.6"
    }
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "remark-parse": "11.0.0",
    "remark-mdx": "3.1.1"
  }
}
